[Unit]
Description=Virtual X display :99 for OpenClaw's managed browser
# Without a display OpenClaw launches Chromium headless, whose HeadlessChrome user agent Cloudflare blocks.

[Service]
ExecStart=/usr/bin/Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp
# Ready only once the socket exists: the gateway is ordered after this unit and may launch Chromium at once.
ExecStartPost=/bin/sh -c 'for i in $(seq 50); do [ -S /tmp/.X11-unix/X99 ] && exit 0; sleep 0.1; done; exit 1'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
